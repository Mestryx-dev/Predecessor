# Local development only — copy to .env (never commit .env)
# Production: set variables in Dokploy UI (saveEnvironment + reload), not in the Git clone.

# Dev SQLite (relative to prisma/)
DATABASE_URL="file:./prisma/dev.db"

# Local Next.js dev server
PORT=3000

# Production on Dokploy (reference — configure in Dokploy, not in repo):
# PORT=3010
# DATABASE_URL=file:/data/prod.db
# NODE_ENV=production
# HOSTNAME=0.0.0.0
